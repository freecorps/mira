# Mira configuration file
# Copy this to .mira.yaml in your repository root

llm:
  # Provider: "openai" (default, any OpenAI-compatible endpoint) or "bedrock" (AWS)
  # provider: "openai"

  # Model identifier (any LiteLLM-supported model)
  model: "openai/gpt-4o"
  # Fallback model if primary fails
  fallback_model: "openai/gpt-4o-mini"
  temperature: 0.2
  max_tokens: 4096

  # ── AWS Bedrock configuration (uncomment to use) ──
  # provider: "bedrock"
  # model: "us.anthropic.claude-sonnet-4-6-v1:0"
  # fallback_model: "us.anthropic.claude-haiku-4-5-v1:0"
  # region: "us-east-1"
  # aws_profile: "my-profile"  # optional, uses default AWS credential chain if omitted

  # ── Or configure the endpoint from the dashboard ──
  # Settings -> Connections -> Add endpoint stores a URL, a key and a
  # protocol in Mira's database, so a container or hosted image needs no
  # file edit. Nothing has to be set here for that; the dashboard writes
  # its own choice and it takes precedence over this file. A purpose can
  # also name one directly, which works here too:
  # review_model: "endpoint:<id>:<model>"
  # See docs/endpoints.md.

  # ── OpenCode Go (uncomment to use) ──
  # The $10/month subscription to open coding models, metered in 5-hour,
  # weekly and monthly windows. Naming the provider fills in the endpoint
  # (https://opencode.ai/zen/go/v1) and the key variable (OPENCODE_API_KEY);
  # model ids are the bare ones the endpoint lists. The Connections page
  # shows the meters. See docs/opencode-go.md.
  # provider: "opencode-go"
  # model: "kimi-k2.7-code"
  # indexing_model: "glm-5.3-flash"

  # Retry and timeout configuration (defaults: 3 attempts, 120s timeout, 2-30s backoff)
  # Increase for flex-tier models or proxied endpoints under load
  # max_retries: 3
  # request_timeout: 120
  # retry_min_wait: 2
  # retry_max_wait: 30

  # Recovery from a model that botches the tool call itself (truncated JSON
  # arguments, prose instead of a call). Separate from max_retries, which
  # covers transport and API failures: extra attempts re-ask with a correction,
  # and json_mode_fallback finally asks for plain JSON instead of a tool call.
  # tool_call_retries: 2
  # json_mode_fallback: true

  # ── Sign in with an account instead of an API key ──
  # Review with the models included in a ChatGPT plan, through the same
  # backend the Codex CLI uses. Connect the account first — from the
  # dashboard (Settings -> Connections) or with `mira auth login chatgpt` —
  # then point reviews at it. The session lives in Mira's database and is
  # renewed automatically; nothing is stored in this file.
  # When set, this wins over provider/base_url/api_key_env: the endpoint and
  # the auth both come from the provider. The dashboard's Connections page
  # sets the same thing, and its choice takes precedence over this one.
  # oauth_provider: "chatgpt"
  # model: "gpt-5-codex"   # or gpt-5; the account's models, not OpenRouter ids

filter:
  # The next three knobs are set by `review.profile` (below) unless written
  # here. A value set here always wins over the profile, so leave them
  # commented out to let the profile decide. Shown with the `balanced` values.
  # Minimum confidence threshold (0.0 - 1.0)
  # confidence_threshold: 0.7
  # Maximum number of suggestion/nitpick comments to post (blockers and
  # warnings are never capped)
  # max_comments: 5
  # Minimum severity level: blocker, warning, suggestion, nitpick
  # min_severity: "nitpick"
  # Glob patterns for files to exclude
  exclude_patterns:
    - "*.lock"
    - "*.lockb"
    - "package-lock.json"
    - "yarn.lock"
    - "pnpm-lock.yaml"
    - "*.min.js"
    - "*.min.css"
    - "*.map"
    - "*.svg"
    - "*.png"
    - "*.jpg"
    - "*.gif"
  # Auto-review only PRs from these authors (empty = review all)
  # allowed_authors:
  #   - alice
  # Never auto-review PRs from these authors (takes precedence over allowed)
  # blocked_authors:
  #   - app/renovate
  #   - app/dependabot
  # Skip deleted files
  exclude_deleted: true
  # File target per agent with auto_complete; total cap in legacy mode
  max_files: 50

review:
  # Review profile: how many comments Mira leaves.
  #   chill      fewer, higher-signal comments: confidence 0.8, at most 3
  #              suggestions, no nitpicks, stricter self-critique
  #   balanced   the defaults (confidence 0.7, at most 5, nitpicks allowed)
  #   assertive  a more thorough pass: confidence 0.55, at most 10, nitpicks
  #              included, more lenient self-critique
  # The profile only fills filter.confidence_threshold, filter.max_comments,
  # filter.min_severity and review.critique_plausible_min_confidence where
  # they are not set explicitly; an explicit value always wins.
  profile: balanced
  # Automatically review every eligible file, across as many agents as needed.
  auto_complete: true
  # Diff token budget and soft file target per agent. Related files stay together.
  agent_token_budget: 24000
  agent_max_files: 12
  # Parallel work and automatic waves (these do not limit total PR coverage).
  max_concurrent_chunks: 5
  max_chunks_per_review: 5
  # Retry failed parts without re-running successful parts.
  chunk_retries: 1
  # Review the parts of one dependency group one after another, each reading
  # the previous parts' notes. Off: all parts run side by side (much faster).
  sequential_parts: false
  # Read the reviewed commit from one archive download (falls back to one API
  # call per file above the size cap, in MB). Also lets grep_repo search the
  # whole repository.
  repo_snapshot: true
  repo_snapshot_max_mb: 250
  # Tokens per review part for the full source of the functions its changed
  # lines sit in. 0 turns it off.
  enclosing_context_tokens: 6000
  # Callers of the functions a PR changes the signature of or removes, found
  # in syntax trees (tree-sitter; regex without the `graph` extra), plus the
  # reviewer's find_usages/find_definition tools. `code_graph: false` turns
  # both off. See docs/code-graph.md.
  code_graph:
    enabled: true
    callers_tokens: 2000      # per review part; 0 keeps only the tools
    max_symbols: 12           # changed symbols looked up per PR
    max_callers: 8            # call sites listed per symbol
    max_files: 400            # files parsed (only those naming a changed symbol)
    max_file_kb: 300
    max_total_mb: 24
    time_budget_seconds: 20
  # Confidence a finding the critic grades "plausible" needs to be posted.
  # Set by `profile` unless written here (balanced: 0.7).
  # critique_plausible_min_confidence: 0.7
  # Lines of context around hunks
  context_lines: 3
  # Legacy total diff cap in characters (only when auto_complete: false)
  max_diff_size: 50000
  # Only flag critical problems/bugs (false = also suggest improvements)
  focus_only_on_problems: false
  # Include a summary comment
  include_summary: true
  # Generate a PR walkthrough comment (top-level summary)
  walkthrough: true
  # Include a Mermaid sequence diagram in the walkthrough
  walkthrough_sequence_diagram: true

  # Upstream release notes for the dependency versions a PR bumps. The review
  # model checks the PR's code against their breaking changes, and the
  # walkthrough lists each bump with its notes and OSV advisories. Best effort:
  # bounded by the budgets below, never fails or holds up a review.
  # MIRA_DEPENDENCY_UPDATES_HOSTS="" turns it off for an offline install.
  # Full reference: docs/dependency-updates.md
  dependency_updates:
    enabled: true
    # `mira local review` contacts only the model unless this is true here AND
    # in the .mira.yaml committed at the review's base.
    local: false
    # Bumps looked up per PR; the rest are listed without notes.
    max_packages: 8
    # Wall-clock budget for the whole lookup, summary included.
    timeout_seconds: 15
    request_timeout_seconds: 5
    # Bytes of release notes and registry metadata downloaded per review
    # (the OSV lookup is a separate, small query bounded by its own timeout).
    max_bytes: 2000000
    # How long the review prompt waits for the notes after its own preparation.
    context_wait_seconds: 3
    # The only hosts contacted (HTTPS; private addresses are refused).
    allowed_hosts:
      - pypi.org
      - registry.npmjs.org
      - proxy.golang.org
      - repo.packagist.org
      - api.github.com
      - raw.githubusercontent.com
      - api.osv.dev               # vulnerabilities fixed / introduced by a bump
    # Env var holding a GitHub token for the releases API (unauthenticated: 60/h per IP).
    github_token_env: ""

  # Submit a real review event, not just comments. Approving is the default;
  # requesting changes is not. An APPROVE adds a signal a human can dismiss —
  # note it counts toward branch-protection approvals — while a
  # REQUEST_CHANGES holds the merge until a later review supersedes it.
  verdict:
    #   off             — comment only
    #   approve         — approve clean PRs, stay silent on findings (default)
    #   request_changes — also request changes on findings above the ceiling
    mode: "approve"
    # Highest severity tolerated in an approved PR: blocker | warning |
    # suggestion | nitpick. "suggestion" approves a PR whose only findings are
    # suggestions and nitpicks.
    approve_max_severity: "suggestion"
    # The walkthrough's merge-readiness score, 1–5, has to be at least this to
    # approve. It asks the question the severity ceiling cannot: not "did I
    # find a problem?" but "did I understand this well enough for finding
    # nothing to mean anything?". 0 turns the floor off; a review with no
    # score (walkthrough disabled) is judged on severity alone.
    approve_min_confidence: 4
    # Never approve when files were skipped for exceeding max_diff_size.
    require_all_files_reviewed: true

  # The commit status / check run that says whether the review has finished.
  # Published as `mira/review`: pending while Mira works, then a terminal
  # state. The name is fixed, because Mira filters its own contexts out of the
  # CI it reads back and a renameable one would eventually be read as a build.
  status:
    enabled: true
    # Publish "in progress" as soon as the review starts.
    pending: true
    # What a finding does to the colour — and only a finding. Mira's own
    # failures are always neutral, never red: red on a pull request reads as a
    # statement about the change, and "the model timed out" is not one.
    #   never          — always green once the review finished
    #   blocker        — red when a blocker was posted (default)
    #   above_ceiling  — red when anything above approve_max_severity was
    fail_on: "blocker"

# ── Generated PR description and title ──
#
# Mira can write a summary into the pull request's description and a title in
# place of a bare `@mira`. It only ever touches text it owns: a marked section,
# a body that was empty, or a title that was nothing but the mention. Comment
# `@mira describe` on a pull request to regenerate on demand.
#
# Full reference: docs/pr-summary.md
pr_summary:
  description:
    # Off by default. The description is the author's text.
    enabled: false
    #   section    — write/refresh a section between <!-- mira:summary:start -->
    #                and <!-- mira:summary:end --> (appended, or where a
    #                `@mira summary` placeholder stood), refreshed on each push;
    #                everything outside it is left exactly as written (default)
    #   empty_only — only fill a body that has no human-written text
    mode: "section"
  title:
    #   off        — never touch the title
    #   on_mention — only while the title is just `@mira` (default)
    #   always     — also on the first review; a title a human sets afterwards
    #                is never overwritten
    mode: "on_mention"

# ── Issue planner ──
#
# An implementation plan posted as a comment on new issues: a summary of the
# ask, the files most likely to change (from the repository index, or from
# file paths when the repository is not indexed), steps, risks and open
# questions, and tests to write. One comment per issue, edited in place on a
# re-run. `@mira plan` on an issue writes or refreshes it on demand. On
# GitHub the App must be subscribed to "Issues" events. See
# docs/issue-planner.md.
issue_planner:
  # Off by default: a comment on every new issue is a team's decision.
  enabled: false
  # Plan when an issue is opened. With false, only `@mira plan` writes one.
  auto_on_open: true
  # Plan an opened issue only when it carries one of these labels (empty:
  # every issue). An explicit `@mira plan` is not held to this list.
  labels: []
  # Never plan an issue carrying one of these, on open or on command.
  ignore_labels: []
  # How many likely files the plan lists (1-25).
  max_files: 8

# ── Digests and release notes ──
#
# What landed on the default branch, summarised per area of the codebase, on a
# schedule, and delivered to the outbound webhooks subscribed to `digest.ready`
# (Settings → Webhooks; Slack, Discord, Teams or generic JSON) and optionally
# by email. `mira digest` and `mira release-notes` use this section too, and
# work whether or not the schedule is enabled.
#
# NOTE: like the gate, this is deployment configuration read by the server.
#
# Full reference: docs/digests.md
digests:
  # Off by default: a scheduled digest spends model calls every period.
  enabled: false
  schedule: "weekly"      # "weekly" | "daily"
  day: "monday"           # weekly only
  hour: 9                 # UTC
  # "repo": one digest per repository. "org": one per owner, areas prefixed
  # with the repository name.
  scope: "repo"
  # `[platform:]owner/repo`. Empty: every repository registered with Mira.
  repositories: []
  # Area name -> path patterns (gate syntax). Files no area claims are grouped
  # by their first `area_depth` directories.
  areas: {}
  #   API: ["src/api/**", "openapi.yaml"]
  #   Docs: ["docs/**", "*.md"]
  area_depth: 1
  # Commits pushed straight to the branch, outside any pull request.
  include_direct_commits: true
  # Caps on what is read from the platform and quoted to the model.
  max_pull_requests: 100
  max_commits: 200
  max_files_per_change: 100
  max_input_chars: 40000
  # false: list changes per area without any model call.
  use_llm: true
  # Do not store or deliver a digest for a period in which nothing landed.
  skip_empty: true
  # Plain-text email. The server comes from MIRA_SMTP_HOST / _PORT / _USER /
  # _PASSWORD / _FROM / _STARTTLS; no host or no recipients means no email.
  email:
    recipients: []
  # How release notes sort pull requests. Labels win over titles; then
  # conventional-commit titles (`feat:`, `fix(api):`, `feat!:`); the model
  # sorts whatever is left.
  release_notes:
    breaking_labels: ["breaking", "breaking-change", "breaking change", "semver-major"]
    feature_labels: ["feature", "enhancement", "feat", "semver-minor"]
    fix_labels: ["bug", "fix", "bugfix", "regression"]
    dependency_labels: ["dependencies", "deps", "dependency"]
    exclude_labels: ["skip-changelog", "no-changelog", "ignore-for-release"]

# ── Merge gate (Phase 4) ──
#
# A conservative approval decision, kept separate from `review.verdict`. The
# verdict says whether the code is good; the gate says whether Mira may put its
# name on merging it. It ships off, and start it in `shadow` — that records the
# decision it *would* have acted on without acting, which is what makes the
# false-approval rate measurable before rollout.
#
# NOTE: gate policy is deployment configuration. The server reads its own
# config, so a `gate:` block committed inside a reviewed repository does not
# change how that repository is gated. Set it on the server or in the dashboard.
#
# Full reference: docs/merge-gate.md
gate:
  #   off      — do not run (default)
  #   shadow   — decide, explain and record; never approve
  #   enforce  — the same decision, plus a real approval when it says so
  mode: "off"
  # Hard-disable everywhere, independent of mode and every per-repo override.
  kill_switch: false

  # Eligibility. Empty allowlists mean "any"; blocklists always win.
  # allowed_base_branches: ["main"]
  # required_labels: ["ready-for-review"]
  blocked_labels: ["do-not-merge", "wip", "hold", "mira-paused"]
  allowed_author_associations: ["OWNER", "MEMBER", "COLLABORATOR"]
  max_changed_files: 20
  max_changed_lines: 500

  # A protected path is an absolute veto — never auto-approved, and no override
  # can force one. Leave `protected_paths` unset to keep the built-in list
  # (CI definitions, migrations, Terraform/Helm/k8s, key material, CODEOWNERS)
  # and add to it here.
  # extra_protected_paths:
  #   - "infra/**"
  #   - "*.tf"

  # Generated output is excluded from the size budget — files *and* their
  # lines. `null` (absent) inherits the built-in list; `[]` means nothing here
  # is generated.
  # generated_paths: null

  # off | risk | block. An owned path is only ever a reason NOT to approve.
  codeowners: "off"

  # Each of these resolves an unknown to "no approval".
  require_ci_success: true
  require_all_files_reviewed: true
  require_index_ready: true
  approve_max_severity: "suggestion"

  # A PR scoring above this is never approved, however clean it looks.
  risk_threshold: 25

  # Enforce mode only, blockers only, and never over an existing human review.
  request_changes_on_blockers: false
  # Publish the explanation as a check run / commit status. Neutral in shadow.
  publish_status: true

  # Revoking a decision by hand is always available to an authorized admin;
  # forcing an approval is a separate power, and is still refused past a
  # protected path, an open blocker, or a human who asked for changes.
  allow_overrides: true
  allow_approval_override: false
  # Admins permitted to move a decision. Empty = every admin.
  # override_admins: ["release-manager"]

  # Per-repository policy. `null`/absent inherits; anything else overrides,
  # including `[]`, which is how a repo opts out of an inherited requirement.
  # repositories:
  #   acme/payments:
  #     mode: "off"
  #   acme/docs:
  #     mode: "enforce"
  #     max_changed_files: 50

# ── Pre-merge checks (Phase 6) ────────────────────────────────────────────
# Reproducible, evidenced answers about a pull request, each with an identity,
# a version and one of five states. The distinction the whole section is built
# around: a `violation` is a statement about the pull request, and
# `infrastructure_error`, `timeout` and `skipped` are statements about Mira.
#
# Nothing in a pull request reaches any value below — not a mode, not a rule,
# not a path glob, not an argument. Full guide: docs/pre-merge-checks.md
checks:
  # Off by default. Turning it on with everything in `warning` reports
  # everything and blocks nothing, which is the recommended first step.
  enabled: false
  # Hard-disable every check everywhere, independent of `enabled` and of every
  # per-scope override. For an incident, not for a policy edit.
  kill_switch: false

  #   off      — does not run. Recorded as skipped, not as a pass.
  #   warning  — runs and reports. Never blocks a merge.
  #   error    — runs, reports, and blocks on a violation *or* on an inability
  #              to answer. Fail closed, in that order.
  default_mode: "warning"
  # modes:
  #   native.tests: "error"
  #   context.ci: "error"
  #   tool.gitleaks: "error"

  # Budget. The defaults assume a four-core board also serving webhooks. A
  # check that overruns is a `timeout`; one that never started because the run
  # budget was spent is `skipped: budget_exhausted`. Neither is a pass.
  max_concurrency: 2
  check_timeout_seconds: 60
  total_timeout_seconds: 300
  max_evidence_per_check: 10

  # Publish the run as a check run / commit status where the provider supports
  # one. Neutral while every check is in warning mode; never red for a check
  # Mira could not run.
  publish_status: true
  # Also post the summary as a PR comment, updated in place.
  comment: false

  # The issue a pull request claims to be about. No external tracker is
  # required: "auto" asks the hosting platform Mira already talks to, and
  # "none" disables lookups entirely while leaving reference extraction on.
  ticket:
    provider: "auto"
    require_reference: true
    require_acceptance_criteria: false
    # Extra shapes for project-specific keys. Compiled at config load.
    # reference_patterns: ["(?P<key>ACME-\d+)"]
    exempt_labels: ["no-ticket", "chore", "dependencies"]
    # A reference names a repository, and a reference is text a contributor
    # wrote. Following one outside this pull request's own repository means
    # Mira asking its privileged token about a repository somebody else chose,
    # which can confirm a private issue exists and quote its title back. Off,
    # and the allowlist is the deliberate opt-in.
    allow_cross_repository: false
    # cross_repository_allowlist: ["acme/tracker"]

  # What CI said, quoted rather than paraphrased. Every limit here is a
  # security control: a CI log is written by whoever can open a pull request.
  ci:
    max_jobs: 3
    max_log_bytes: 16000
    max_evidence_lines: 20
    # Off by default: the job name, step and quoted lines are already evidence,
    # and a deployment that does not want its CI output leaving the box does
    # not have to send it anywhere.
    summarize_with_llm: false

  # Deterministic analysers. `name` comes from a closed allowlist — semgrep,
  # ruff, eslint, gitleaks, osv — checked when the config loads. `args` is an
  # argument *list*: there is no shell, so there is nothing to inject into.
  # A tool that is not installed is reported as skipped with the binary named,
  # never as a pass.
  # tools:
  #   - name: "ruff"
  #     mode: "warning"
  #   - name: "gitleaks"
  #     mode: "error"
  #   - name: "semgrep"
  #     # Repository-relative, validated at load. Absolute paths and `..` are
  #     # refused.
  #     config_path: ".semgrep.yml"
  #     # Substring of the tool's own --version. A mismatch is a skip naming
  #     # both versions, not a run under rules nobody reviewed.
  #     require_version: "1.9"
  #   - name: "osv"
  #     # Reuses the review's existing OSV scan rather than repeating it.

  # Checks written as instructions. The instruction is policy and lives in the
  # system prompt; the diff and the pull request's text go in untrusted blocks.
  # A violation must quote code that exists — the quote is verified — and an
  # `uncertain` answer becomes a skip rather than an invented finding.
  # natural_language:
  #   - id: "rate-limit"
  #     title: "Endpoints declare a rate limit"
  #     instruction: "Every new HTTP endpoint must declare a rate limit."
  #     paths: ["src/api/**/*.py"]
  #     mode: "warning"
  #     version: "1"

  # Three layers: this block, then the organisation, then the repository.
  # `modes` merge key by key; lists replace (so `[]` means "none here"); tools
  # merge by name.
  # organizations:
  #   acme:
  #     modes: { native.docs: "error" }
  # repositories:
  #   acme/legacy-service:
  #     modes: { native.tests: "off" }
  #     tools:
  #       - name: "ruff"
  #         enabled: false

# ── Assisted correction (Phase 5) ─────────────────────────────────────────────
#
# `@mira fix`, `@mira fix all`, and the finishing touches `@mira generate tests`
# and `@mira generate docstrings`. Off by default; start with `suggest`, which
# generates and validates a patch and writes nothing. When it writes, it writes
# to Mira's own branch and a stacked pull request, never to the default branch.
#
# NOTE: like the gate, autofix policy is deployment configuration — a block
# committed inside a reviewed repository does not change it.
#
# Full reference: docs/autofix.md
autofix:
  mode: "off"                # off | suggest | on
  # Each finishing touch is off on its own, even with `mode` on. Tests touch
  # test files only; a docstring patch that changes code is refused.
  finishing_touches:
    tests: false             # @mira generate tests
    docstrings: false        # @mira generate docstrings
  # repositories:
  #   acme/app:
  #     mode: "on"
  #     finishing_touches: { tests: true, docstrings: true }

# ── Reviewer triage (Phase 7C) ────────────────────────────────────────────────
#
# What a change is, and who is closest to it. Mira suggests; a human decides.
# Nothing here assigns a reviewer, requests a review or mentions anybody, and
# no status is published, so no merge can ever wait on a ranking.
triage:
  # Off by default. Turning it on starts two things: a suggestion comment on
  # reviewed pull requests, and a record of who authored and reviewed which
  # files — kept only for repositories where this is on.
  enabled: false

  # Stops every suggestion everywhere in one edit, independent of `enabled` and
  # of every per-scope override. For an incident, not for a policy edit.
  kill_switch: false

  # Post the suggestion as a comment, updated in place, never on a draft.
  # There is deliberately no status-publishing option.
  comment: true

  max_suggestions: 3

  # Just under the weight of one authorship: one file you changed recently is
  # enough to be suggested, the same file changed most of a window ago is not.
  min_score: 0.75

  # The two signals. CODEOWNERS is the repository *stating* who reviews a file
  # and is read at the pull request's base commit, so a branch cannot add
  # itself an owner. History is Mira *inferring* it from commits the platform
  # attributed to an account and from reviews Mira watched.
  codeowners: true
  history: true

  # How far back history counts, and how hard it may look. The caps are the
  # Orange Pi's: a pull request touching 300 files must not become 300 API
  # calls.
  history_days: 180
  history_max_paths: 12
  history_max_per_path: 20
  history_refresh_hours: 168

  # Never suggested, whatever the signals say. The answer to "please stop
  # suggesting me", matched with or without the `@` and case-insensitively.
  exclude: []

  # Skip identities that look like machines: anything ending in `[bot]`, plus
  # the logins below for accounts whose names do not say so.
  exclude_bots: true
  bots: []

  # Points off per pull request already waiting on somebody. A dampener, not a
  # cap — the best reviewer is still the best reviewer when they are busy.
  load_penalty: 0.25

  # Whole-run budget. A suggestion that arrives after the human has already
  # picked somebody is worth nothing.
  budget_seconds: 30

  # Declared ownership above observed history, on purpose: when the two
  # disagree, the repository's own statement should win. A scope that
  # overrides these sets all three.
  weights:
    codeowners: 3.0
    reviewed: 1.5
    authored: 1.0

  # Three layers: this block, then the organisation, then the repository.
  # `null` inherits, anything else overrides, and `[]` means "empty here".
  # organizations:
  #   acme:
  #     max_suggestions: 2
  # repositories:
  #   acme/infra:
  #     history: false        # CODEOWNERS only here

# License policy for the dependencies a pull request adds or bumps. Off by
# default; no model is called. Licenses come from the lockfile when it records
# them (package-lock.json, composer.lock), then Mira's cache, then the package
# registry. See docs/sbom-licenses.md — and `mira sbom` for SBOM export.
licenses:
  enabled: false
  # SPDX ids or simple expressions. Empty `allow`: anything not denied passes.
  # A bare GNU family (GPL-3.0) matches both -only and -or-later.
  allow: []
  #   - MIT
  #   - Apache-2.0
  #   - BSD-3-Clause
  #   - ISC
  deny: []
  #   - GPL-3.0
  #   - AGPL-3.0
  # A package whose license cannot be determined is a violation.
  fail_on_unknown: false
  # "warning", or "blocker" to make a violation fail the review status the way
  # any blocker does (see review.status.fail_on).
  severity: warning
  ignore_dev: false
  ignore_packages: []
  # Ask the registry when neither the lockfile nor the cache knows. Only these
  # hosts, over HTTPS, no redirects, no private addresses, within one budget.
  # MIRA_LICENSES_HOSTS="" in the environment keeps an install offline.
  lookup: true
  max_lookups: 25
  timeout_seconds: 10
  allowed_hosts:
    - registry.npmjs.org
    - pypi.org
    - crates.io
    - api.deps.dev
    - repo.packagist.org
