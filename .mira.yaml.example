# Mira configuration file
# Copy this to .mira.yaml in your repository root

llm:
  # Provider: "openai" (default, any OpenAI-compatible endpoint) or "bedrock" (AWS)
  # provider: "openai"

  # Model identifier (any LiteLLM-supported model)
  model: "openai/gpt-4o"
  # Fallback model if primary fails
  fallback_model: "openai/gpt-4o-mini"
  temperature: 0.2
  max_tokens: 4096

  # ── AWS Bedrock configuration (uncomment to use) ──
  # provider: "bedrock"
  # model: "us.anthropic.claude-sonnet-4-6-v1:0"
  # fallback_model: "us.anthropic.claude-haiku-4-5-v1:0"
  # region: "us-east-1"
  # aws_profile: "my-profile"  # optional, uses default AWS credential chain if omitted

  # Retry and timeout configuration (defaults: 3 attempts, 120s timeout, 2-30s backoff)
  # Increase for flex-tier models or proxied endpoints under load
  # max_retries: 3
  # request_timeout: 120
  # retry_min_wait: 2
  # retry_max_wait: 30

filter:
  # Minimum confidence threshold (0.0 - 1.0)
  confidence_threshold: 0.7
  # Maximum number of comments to post
  max_comments: 5
  # Minimum severity level: blocker, warning, suggestion, nitpick
  min_severity: "nitpick"
  # Glob patterns for files to exclude
  exclude_patterns:
    - "*.lock"
    - "*.lockb"
    - "package-lock.json"
    - "yarn.lock"
    - "pnpm-lock.yaml"
    - "*.min.js"
    - "*.min.css"
    - "*.map"
    - "*.svg"
    - "*.png"
    - "*.jpg"
    - "*.gif"
  # Auto-review only PRs from these authors (empty = review all)
  # allowed_authors:
  #   - alice
  # Never auto-review PRs from these authors (takes precedence over allowed)
  # blocked_authors:
  #   - app/renovate
  #   - app/dependabot
  # Skip deleted files
  exclude_deleted: true
  # Maximum number of files to review
  max_files: 50

review:
  # Lines of context around hunks
  context_lines: 3
  # Maximum diff size in characters
  max_diff_size: 50000
  # Only flag critical problems/bugs (false = also suggest improvements)
  focus_only_on_problems: false
  # Include a summary comment
  include_summary: true
  # Generate a PR walkthrough comment (top-level summary)
  walkthrough: true
  # Include a Mermaid sequence diagram in the walkthrough
  walkthrough_sequence_diagram: true

  # Submit a real review event, not just comments. Off by default: an APPROVE
  # from a GitHub App counts toward branch-protection approvals, and a
  # REQUEST_CHANGES blocks the merge until a later review supersedes it.
  verdict:
    #   off             — comment only (default)
    #   approve         — approve clean PRs, stay silent on findings
    #   request_changes — also request changes on findings above the ceiling
    mode: "off"
    # Highest severity tolerated in an approved PR: blocker | warning |
    # suggestion | nitpick. "suggestion" approves a PR whose only findings are
    # suggestions and nitpicks.
    approve_max_severity: "suggestion"
    # Never approve when files were skipped for exceeding max_diff_size.
    require_all_files_reviewed: true

# ── Merge gate (Phase 4) ──
#
# A conservative approval decision, kept separate from `review.verdict`. The
# verdict says whether the code is good; the gate says whether Mira may put its
# name on merging it. It ships off, and start it in `shadow` — that records the
# decision it *would* have acted on without acting, which is what makes the
# false-approval rate measurable before rollout.
#
# NOTE: gate policy is deployment configuration. The server reads its own
# config, so a `gate:` block committed inside a reviewed repository does not
# change how that repository is gated. Set it on the server or in the dashboard.
#
# Full reference: docs/merge-gate.md
gate:
  #   off      — do not run (default)
  #   shadow   — decide, explain and record; never approve
  #   enforce  — the same decision, plus a real approval when it says so
  mode: "off"
  # Hard-disable everywhere, independent of mode and every per-repo override.
  kill_switch: false

  # Eligibility. Empty allowlists mean "any"; blocklists always win.
  # allowed_base_branches: ["main"]
  # required_labels: ["ready-for-review"]
  blocked_labels: ["do-not-merge", "wip", "hold", "mira-paused"]
  allowed_author_associations: ["OWNER", "MEMBER", "COLLABORATOR"]
  max_changed_files: 20
  max_changed_lines: 500

  # A protected path is an absolute veto — never auto-approved, and no override
  # can force one. Leave `protected_paths` unset to keep the built-in list
  # (CI definitions, migrations, Terraform/Helm/k8s, key material, CODEOWNERS)
  # and add to it here.
  # extra_protected_paths:
  #   - "infra/**"
  #   - "*.tf"

  # Generated output is excluded from the size budget — files *and* their
  # lines. `null` (absent) inherits the built-in list; `[]` means nothing here
  # is generated.
  # generated_paths: null

  # off | risk | block. An owned path is only ever a reason NOT to approve.
  codeowners: "off"

  # Each of these resolves an unknown to "no approval".
  require_ci_success: true
  require_all_files_reviewed: true
  require_index_ready: true
  approve_max_severity: "suggestion"

  # A PR scoring above this is never approved, however clean it looks.
  risk_threshold: 25

  # Enforce mode only, blockers only, and never over an existing human review.
  request_changes_on_blockers: false
  # Publish the explanation as a check run / commit status. Neutral in shadow.
  publish_status: true

  # Revoking a decision by hand is always available to an authorized admin;
  # forcing an approval is a separate power, and is still refused past a
  # protected path, an open blocker, or a human who asked for changes.
  allow_overrides: true
  allow_approval_override: false
  # Admins permitted to move a decision. Empty = every admin.
  # override_admins: ["release-manager"]

  # Per-repository policy. `null`/absent inherits; anything else overrides,
  # including `[]`, which is how a repo opts out of an inherited requirement.
  # repositories:
  #   acme/payments:
  #     mode: "off"
  #   acme/docs:
  #     mode: "enforce"
  #     max_changed_files: 50

# ── Pre-merge checks (Phase 6) ────────────────────────────────────────────
# Reproducible, evidenced answers about a pull request, each with an identity,
# a version and one of five states. The distinction the whole section is built
# around: a `violation` is a statement about the pull request, and
# `infrastructure_error`, `timeout` and `skipped` are statements about Mira.
#
# Nothing in a pull request reaches any value below — not a mode, not a rule,
# not a path glob, not an argument. Full guide: docs/pre-merge-checks.md
checks:
  # Off by default. Turning it on with everything in `warning` reports
  # everything and blocks nothing, which is the recommended first step.
  enabled: false
  # Hard-disable every check everywhere, independent of `enabled` and of every
  # per-scope override. For an incident, not for a policy edit.
  kill_switch: false

  #   off      — does not run. Recorded as skipped, not as a pass.
  #   warning  — runs and reports. Never blocks a merge.
  #   error    — runs, reports, and blocks on a violation *or* on an inability
  #              to answer. Fail closed, in that order.
  default_mode: "warning"
  # modes:
  #   native.tests: "error"
  #   context.ci: "error"
  #   tool.gitleaks: "error"

  # Budget. The defaults assume a four-core board also serving webhooks. A
  # check that overruns is a `timeout`; one that never started because the run
  # budget was spent is `skipped: budget_exhausted`. Neither is a pass.
  max_concurrency: 2
  check_timeout_seconds: 60
  total_timeout_seconds: 300
  max_evidence_per_check: 10

  # Publish the run as a check run / commit status where the provider supports
  # one. Neutral while every check is in warning mode; never red for a check
  # Mira could not run.
  publish_status: true
  # Also post the summary as a PR comment, updated in place.
  comment: false

  # The issue a pull request claims to be about. No external tracker is
  # required: "auto" asks the hosting platform Mira already talks to, and
  # "none" disables lookups entirely while leaving reference extraction on.
  ticket:
    provider: "auto"
    require_reference: true
    require_acceptance_criteria: false
    # Extra shapes for project-specific keys. Compiled at config load.
    # reference_patterns: ["(?P<key>ACME-\d+)"]
    exempt_labels: ["no-ticket", "chore", "dependencies"]
    # A reference names a repository, and a reference is text a contributor
    # wrote. Following one outside this pull request's own repository means
    # Mira asking its privileged token about a repository somebody else chose,
    # which can confirm a private issue exists and quote its title back. Off,
    # and the allowlist is the deliberate opt-in.
    allow_cross_repository: false
    # cross_repository_allowlist: ["acme/tracker"]

  # What CI said, quoted rather than paraphrased. Every limit here is a
  # security control: a CI log is written by whoever can open a pull request.
  ci:
    max_jobs: 3
    max_log_bytes: 16000
    max_evidence_lines: 20
    # Off by default: the job name, step and quoted lines are already evidence,
    # and a deployment that does not want its CI output leaving the box does
    # not have to send it anywhere.
    summarize_with_llm: false

  # Deterministic analysers. `name` comes from a closed allowlist — semgrep,
  # ruff, eslint, gitleaks, osv — checked when the config loads. `args` is an
  # argument *list*: there is no shell, so there is nothing to inject into.
  # A tool that is not installed is reported as skipped with the binary named,
  # never as a pass.
  # tools:
  #   - name: "ruff"
  #     mode: "warning"
  #   - name: "gitleaks"
  #     mode: "error"
  #   - name: "semgrep"
  #     # Repository-relative, validated at load. Absolute paths and `..` are
  #     # refused.
  #     config_path: ".semgrep.yml"
  #     # Substring of the tool's own --version. A mismatch is a skip naming
  #     # both versions, not a run under rules nobody reviewed.
  #     require_version: "1.9"
  #   - name: "osv"
  #     # Reuses the review's existing OSV scan rather than repeating it.

  # Checks written as instructions. The instruction is policy and lives in the
  # system prompt; the diff and the pull request's text go in untrusted blocks.
  # A violation must quote code that exists — the quote is verified — and an
  # `uncertain` answer becomes a skip rather than an invented finding.
  # natural_language:
  #   - id: "rate-limit"
  #     title: "Endpoints declare a rate limit"
  #     instruction: "Every new HTTP endpoint must declare a rate limit."
  #     paths: ["src/api/**/*.py"]
  #     mode: "warning"
  #     version: "1"

  # Three layers: this block, then the organisation, then the repository.
  # `modes` merge key by key; lists replace (so `[]` means "none here"); tools
  # merge by name.
  # organizations:
  #   acme:
  #     modes: { native.docs: "error" }
  # repositories:
  #   acme/legacy-service:
  #     modes: { native.tests: "off" }
  #     tools:
  #       - name: "ruff"
  #         enabled: false
