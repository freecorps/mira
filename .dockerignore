.git/
.github/
.claude/
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.*
htmlcov/
.venv/
.tox/
*.egg-info/
build/
dist/

# UI build artifacts and node_modules — Dockerfile builds the UI fresh in stage 1.
ui/mira/node_modules/
ui/mira/dist/
ui/mira/.vite/

# Not part of the image — the Dockerfile copies only src/, ui/mira/,
# pyproject.toml, uv.lock and README.md. Keeping the rest out of the build
# context makes the context upload (and cache-key hashing) cheaper.
tests/
docs/
deploy/
scripts/
*.md
!README.md
.mira.yaml.example
.pre-commit-config.yaml
.editorconfig
fly.toml
railway.toml
render.yaml

# Local state — never bake into image
data/
*.pem
*.key
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.swp

# Plans & ephemeral
*.private-key.pem
